# =============================================
# TigerGraph Agentic Fraud Investigation
# Copy this to .env and fill in your values
# NEVER commit .env to git
# =============================================

# --- Google Gemini ---
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# --- TigerGraph Savanna ---
TG_HOST=https://your-host.i.tgcloud.io
TG_GRAPH=FraudInvestigation
TG_USERNAME=tigergraph
TG_PASSWORD=your_password_here
TG_SECRET=your_secret_here   # alternative to username/password

# --- FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Agent Config ---
MAX_EVIDENCE_LOOPS=2          # max iterations of gather_more_evidence
CONFIDENCE_THRESHOLD=0.65     # below this → loop back for more evidence
SAR_EXPOSURE_THRESHOLD=5000   # USD — FILE_REPORT if exposure exceeds this
