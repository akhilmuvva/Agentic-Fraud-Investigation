// =============================================================================
// Pattern 1 — Card-Not-Present Fraud
// Query    : detect_card_not_present_fraud
// Graph    : FraudInvestigation
// =============================================================================

USE GRAPH FraudInvestigation

CREATE OR REPLACE QUERY detect_card_not_present_fraud(
    STRING card_id,
    INT    lookback_days
) FOR GRAPH FraudInvestigation {
    TYPEDEF TUPLE<
        DOUBLE risk_score,
        STRING transaction_id,
        FLOAT  TransactionAmt,
        INT    mismatch_count,
        BOOL   high_addr_diversity,
        STRING m1_flag,
        STRING m6_flag,
        STRING m9_flag,
        FLOAT  c1_value
    > SuspiciousTxTuple;

    HeapAccum<SuspiciousTxTuple>(10, risk_score DESC) @@suspicious_txns;

    SumAccum<INT>    @@total_cnp_scanned    = 0;
    SumAccum<INT>    @@total_mismatch_cnt   = 0;
    SumAccum<DOUBLE> @@max_risk             = 0.0;

    Seed = {Card.*};
    TargetCard = SELECT c
                 FROM   Seed:c
                 WHERE  c.card_id == card_id;

    IF TargetCard.size() == 0 THEN
        PRINT "Card not found: " + card_id;
        RETURN;
    END;

    MaxAccum<INT> @@max_dt = 0;
    _ = SELECT t
        FROM   TargetCard:c -(USED_IN:e)-> Transaction:t
        ACCUM  @@max_dt += t.TransactionDT;

    INT lookback_seconds = lookback_days * 86400;
    INT window_start     = @@max_dt - lookback_seconds;

    SuspectedTxns = SELECT t
        FROM TargetCard:c -(USED_IN:e)-> Transaction:t
        WHERE
            t.TransactionDT >= window_start
            AND (t.ProductCD == "W" OR t.ProductCD == "H")
        ACCUM
            @@total_cnp_scanned += 1,

            INT mismatch = 0,
            IF t.M1 != "T" THEN mismatch = mismatch + 1 END,
            IF t.M6 != "T" THEN mismatch = mismatch + 1 END,
            IF t.M9 != "T" THEN mismatch = mismatch + 1 END,
            @@total_mismatch_cnt += mismatch,

            BOOL high_addr = (t.C1 > 5),

            DOUBLE risk = 0.3
                        + (mismatch * 0.2)
                        + (CASE WHEN t.C1 > 5 THEN 0.2 ELSE 0.0 END),
            DOUBLE capped_risk = CASE WHEN risk > 1.0 THEN 1.0 ELSE risk END,

            IF mismatch > 0 OR high_addr THEN
                @@suspicious_txns += SuspiciousTxTuple(
                    capped_risk,
                    t.transaction_id,
                    t.TransactionAmt,
                    mismatch,
                    high_addr,
                    t.M1,
                    t.M6,
                    t.M9,
                    t.C1
                ),
                @@max_risk += capped_risk
            END;

    PRINT @@total_cnp_scanned AS total_cnp_transactions_scanned;
    PRINT @@total_mismatch_cnt AS total_identity_mismatch_events;
    PRINT @@suspicious_txns    AS suspicious_transactions;
    PRINT card_id              AS queried_card_id;
    PRINT lookback_days        AS lookback_days_used;
}

INSTALL QUERY detect_card_not_present_fraud
